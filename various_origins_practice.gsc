            break;
        case 3:
            level thread init_op();
            break;
        case 4:
            level thread init_tp();
            break;
    }
}

on_player_connect()
{
    self endon( "end_game" );

    for (;;)
    {
        self waittill( "connected", player );
        player thread on_player_spawned();
    }
}

on_player_spawned()
{
    level endon( "end_game" );
    self endon( "disconnect" );
    self waittill( "spawned_player" );
    self thread menu_monitor_actions();

    switch ( getdvarint( "origins_practice_menu_mode" ) )
    {
        case 0:
            self on_player_spawned_ep();
            break;
        case 1:
            self on_player_spawned_wsp();
            break;
        case 2:
            self on_player_spawned_fp();
            break;
        case 3:
            self on_player_spawned_op();
            break;
        case 4:
            self on_player_spawned_tp();
            break;
    }
}

