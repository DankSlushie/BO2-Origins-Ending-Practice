menu_flash_instructions()
{
    self endon( "end_game" );
    flag_wait( "initial_blackscreen_passed" );
    level.menu.open_instructions.alpha = 0.7;
    wait 5;
    level.menu.open_instructions.alpha = 0;
}

menu_monitor_actions()
{
    self endon( "disconnect" );
    self endon( "death" );
    flag_wait( "initial_blackscreen_passed" );

    for (;;)
    {
        if ( level.menu.current_page == 0 )
        {
            if ( self meleebuttonpressed() && self secondaryoffhandbuttonpressed() )
            {
                level.menu.current_page = 1;
                menu_set_row_alpha( 1 );
                level.menu.nav_instructions.alpha = 0.7;
            }
        }
        else
        {
            if ( self actionslotonebuttonpressed() )
                menu_up();

            if ( self actionslottwobuttonpressed() )
                menu_down();

            if ( self actionslotthreebuttonpressed() )
            {
                menu_select();
                wait 0.25;
                continue;
            }

            if ( self actionslotfourbuttonpressed() )
            {
                menu_back();
                wait 0.25;
                continue;
            }
        }

        wait 0.05;
    }
}

menu_set_row_alpha( a )
{
    for ( i = 0; i < level.menu.row_labels.size; i++ )
        level.menu.row_labels[i].alpha = a;
}

menu_set_col_alpha( row, a )
{
    for ( i = 0; i < level.menu.matrix[row].size; i++ )
        level.menu.matrix[row][i].hud.alpha = a;
}

menu_set_row_highlight( color )
{
    level.menu.row_labels[getdvarint( "origins_practice_menu_row" )].color = color;
}

menu_set_col_highlight( color )
{
    level.menu.matrix[getdvarint( "origins_practice_menu_row" )][getdvarint( "origins_practice_menu_col" )].hud.color = color;
}

menu_up()
{
    if ( level.menu.current_page == 1 )
    {
        menu_set_row_highlight( ( 1, 1, 1 ) );
        row = getdvarint( "origins_practice_menu_row" );
        row = row - 1;

        if ( row < 0 )
            row = level.menu.row_labels.size - 1;

        setdvar( "origins_practice_menu_row", row );
        menu_set_row_highlight( level.menu.highlight_color );
    }
    else if ( level.menu.current_page == 2 )
    {
        menu_set_col_highlight( ( 1, 1, 1 ) );
        col = getdvarint( "origins_practice_menu_col" );
        col = col - 1;

        if ( col < 0 )
            col = level.menu.matrix[getdvarint( "origins_practice_menu_row" )].size - 1;

        setdvar( "origins_practice_menu_col", col );
        menu_set_col_highlight( level.menu.highlight_color );
    }
}

menu_down()
{
    if ( level.menu.current_page == 1 )
    {
        menu_set_row_highlight( ( 1, 1, 1 ) );
        row = getdvarint( "origins_practice_menu_row" );
        row = ( row + 1 ) % level.menu.row_labels.size;
        setdvar( "origins_practice_menu_row", row );
        menu_set_row_highlight( level.menu.highlight_color );
    }
    else if ( level.menu.current_page == 2 )
    {
        menu_set_col_highlight( ( 1, 1, 1 ) );
        col = getdvarint( "origins_practice_menu_col" );
        col = ( col + 1 ) % level.menu.matrix[getdvarint( "origins_practice_menu_row" )].size;
        setdvar( "origins_practice_menu_col", col );
        menu_set_col_highlight( level.menu.highlight_color );
    }
}

menu_select()
{
    if ( level.menu.current_page == 1 )
    {
        level.menu.current_page = 2;
        row = getdvarint( "origins_practice_menu_row" );
        setdvar( "origins_practice_menu_col", 0 );
        menu_set_row_alpha( 0 );
        menu_set_col_alpha( row, 1 );
        menu_set_col_highlight( level.menu.highlight_color );
    }
    else if ( level.menu.current_page == 2 )
        [[ level.menu.matrix[getdvarint( "origins_practice_menu_row" )][getdvarint( "origins_practice_menu_col" )].callback ]]();
}

menu_back()
{
    if ( level.menu.current_page == 1 )
    {
        level.menu.current_page = 0;
        menu_set_row_alpha( 0 );
        level.menu.nav_instructions.alpha = 0;
    }
    else if ( level.menu.current_page == 2 )
    {
        level.menu.current_page = 1;
        menu_set_col_highlight( ( 1, 1, 1 ) );
        menu_set_col_alpha( getdvarint( "origins_practice_menu_row" ), 0 );
        menu_set_row_alpha( 1 );
    }
}

practice_mode_callback()
{
    row = getdvarint( "origins_practice_menu_row" );
    col = getdvarint( "origins_practice_menu_col" );
    setdvar( "origins_practice_menu_mode", col );
    map_restart();
}

